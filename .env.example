# Adria Stay Budva — Phase 2 (Supabase + authentication)
#
# Copy this file to .env.local and fill in the values from your own
# Supabase project. See README.md → "Phase 2 setup" for the full,
# step-by-step walkthrough (creating the project, running migrations,
# configuring auth redirect URLs, running onboarding, etc).
#
# None of these have default values — the app fails safely (a clear,
# developer-only message) when they're missing, rather than pretending
# to work. See lib/supabase/env.ts.

# Project URL and anon (public) key — Supabase dashboard → Settings → API.
# Safe to expose to the browser; Row Level Security is what keeps data
# private, not secrecy of these two values.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service-role key — Supabase dashboard → Settings → API → "service_role" secret.
# NEVER prefix this with NEXT_PUBLIC_. It bypasses Row Level Security
# entirely and must only ever be read on the server (see
# lib/supabase/admin.ts, which is guarded by the `server-only` package —
# importing it from a Client Component is a build error, not just a lint
# warning).
SUPABASE_SERVICE_ROLE_KEY=

# Which chat backend the /api/widget/* routes use (lib/server/chat-provider.ts).
# Only "mock" is implemented right now — the deterministic, keyword-based
# engine in lib/chat/mock-chat-service.ts. Defaults to "mock" even if this
# variable is unset, and never checks for OPENAI_API_KEY: the assistant
# must keep working in mock mode with no AI API key at all, in every
# environment. Provider selection happens only on the server — the
# browser never chooses it. A future "openai" provider may be added
# later (see ROADMAP.md Phase 3) without changing this variable's shape.
CHAT_PROVIDER=mock

# Nothing else is needed. The public landing page resolves the demo
# business's public_widget_id itself, server-side, from the well-known
# slug "adria-stay-budva" (see lib/chat/knowledge.ts DEMO_BUSINESS_SLUG
# and lib/server/widget-service.ts resolveActiveBusinessBySlug) — there
# is no NEXT_PUBLIC_WIDGET_ID to copy-paste after signing up.
