# Adria Stay Budva — Phase 2 (Supabase + authentication)
#
# Copy this file to .env.local and fill in the values from your own
# Supabase project. See README.md → "Phase 2 setup" for the full,
# step-by-step walkthrough (creating the project, running migrations,
# configuring auth redirect URLs, running onboarding, etc).
#
# None of these have default values — the app fails safely (a clear,
# developer-only message) when they're missing, rather than pretending
# to work. See lib/supabase/env.ts.

# Project URL and anon (public) key — Supabase dashboard → Settings → API.
# Safe to expose to the browser; Row Level Security is what keeps data
# private, not secrecy of these two values.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service-role key — Supabase dashboard → Settings → API → "service_role" secret.
# NEVER prefix this with NEXT_PUBLIC_. It bypasses Row Level Security
# entirely and must only ever be read on the server (see
# lib/supabase/admin.ts, which is guarded by the `server-only` package —
# importing it from a Client Component is a build error, not just a lint
# warning).
SUPABASE_SERVICE_ROLE_KEY=

# The public chat widget's businesses.public_widget_id. Not a Supabase
# credential — this is a single-tenant demo, so the landing page needs
# to know *which* business's widget to render, and a business's
# public_widget_id only exists once its owner has signed up (see the
# onboarding trigger in supabase/migrations). After your first sign-up,
# find it on the dashboard's Settings tab and paste it here. Phase 4
# (embeddable widget) replaces this with per-embed configuration instead
# of a build-time environment variable.
NEXT_PUBLIC_WIDGET_ID=
